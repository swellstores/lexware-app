{
  "collection": "documents",
  "label": "Lexware documents",
  "description": "Invoices and credit notes created in Lexware Office, and the ones that could not be created.",
  "fields": [
    {
      "id": "number",
      "label": "Number",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "type",
      "label": "Type",
      "type": "select",
      "readonly": true,
      "options": [
        {
          "value": "invoice",
          "label": "Invoice"
        },
        {
          "value": "credit_note",
          "label": "Credit note"
        }
      ]
    },
    {
      "id": "status",
      "label": "Status",
      "type": "select",
      "readonly": true,
      "options": [
        {
          "value": "created",
          "label": "In Lexware"
        },
        {
          "value": "pending",
          "label": "In progress"
        },
        {
          "value": "failed",
          "label": "Needs attention"
        },
        {
          "value": "skipped",
          "label": "Skipped"
        },
        {
          "value": "resolved",
          "label": "Resolved by hand"
        }
      ]
    },
    {
      "id": "amount",
      "label": "Total (EUR)",
      "type": "number",
      "digits": 2,
      "readonly": true
    },
    {
      "id": "lexware_status",
      "label": "Status in Lexware",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "date_issued",
      "label": "Document date",
      "type": "date",
      "readonly": true
    },
    {
      "id": "invoice_number",
      "label": "For invoice",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "order",
      "label": "Order",
      "type": "lookup",
      "model": "orders",
      "key": "order_id",
      "readonly": true
    },
    {
      "id": "order_number",
      "label": "Order",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "customer_name",
      "label": "Customer",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "customer_email",
      "label": "Customer e-mail",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "tax_type",
      "label": "Lexware tax type",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "pdf",
      "label": "PDF",
      "type": "document",
      "readonly": true
    },
    {
      "id": "problem",
      "label": "Problem",
      "type": "long_text",
      "readonly": true
    },
    {
      "id": "notify_customer",
      "label": "E-mailed to customer",
      "type": "toggle",
      "readonly": true
    },
    {
      "id": "attempts",
      "label": "Attempts",
      "type": "integer",
      "readonly": true
    },
    {
      "id": "date_attempted",
      "label": "Last attempt",
      "type": "datetime",
      "readonly": true
    },
    {
      "id": "source",
      "label": "Started by",
      "type": "short_text",
      "readonly": true
    }
  ],
  "views": [
    {
      "id": "list",
      "nav": {
        "label": "Lexware documents",
        "parent": "orders"
      },
      "sort": "date_created desc",
      "tabs": [
        {
          "id": "attention",
          "label": "Needs attention",
          "query": {
            "status": "failed"
          }
        },
        {
          "id": "created",
          "label": "In Lexware",
          "query": {
            "status": "created"
          }
        },
        {
          "id": "drafts",
          "label": "Drafts",
          "query": {
            "status": "created",
            "lexware_status": "draft"
          }
        },
        {
          "id": "skipped",
          "label": "Skipped",
          "query": {
            "status": "skipped"
          }
        }
      ],
      "fields": [
        {
          "id": "number"
        },
        {
          "id": "type"
        },
        {
          "id": "order_number"
        },
        {
          "id": "customer_name"
        },
        {
          "id": "amount"
        },
        {
          "id": "status"
        },
        {
          "id": "problem",
          "truncated": 60
        },
        {
          "id": "date_created",
          "label": "Created",
          "type": "datetime"
        }
      ],
      "actions": [
        {
          "id": "open-lexware",
          "label": "Open Lexware",
          "link": "https://app.lexware.de",
          "target": "blank"
        }
      ],
      "bulk_actions": [
        {
          "id": "retry-selected",
          "label": "Retry",
          "function": "process-documents",
          "loading_label": "Starting…",
          "modal": {
            "title": "Retry the selected documents",
            "description": "Tries again to create the selected documents in Lexware, and reads drafts again. A document that exists in Lexware is never created twice.",
            "submit_label": "Retry"
          }
        }
      ]
    },
    {
      "id": "edit",
      "fields": [
        {
          "type": "field_row",
          "fields": [
            {
              "id": "type",
              "admin_span": 1
            },
            {
              "id": "number",
              "admin_span": 1
            },
            {
              "id": "status",
              "admin_span": 1
            },
            {
              "id": "amount",
              "admin_span": 1
            }
          ]
        },
        {
          "id": "problem",
          "conditions": {
            "problem": {
              "$exists": true,
              "$ne": null
            }
          }
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "order",
              "admin_span": 2
            },
            {
              "id": "customer_name",
              "admin_span": 2
            }
          ]
        },
        {
          "id": "pdf",
          "conditions": {
            "pdf": {
              "$exists": true,
              "$ne": null
            }
          }
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "lexware_status",
              "admin_span": 1
            },
            {
              "id": "date_issued",
              "admin_span": 1
            },
            {
              "id": "tax_type",
              "admin_span": 1
            },
            {
              "id": "invoice_number",
              "admin_span": 1,
              "conditions": {
                "type": "credit_note"
              }
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "customer_email",
              "admin_span": 2
            },
            {
              "id": "notify_customer",
              "admin_span": 2
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "source",
              "admin_span": 2
            },
            {
              "id": "attempts",
              "admin_span": 1
            },
            {
              "id": "date_attempted",
              "admin_span": 1
            }
          ]
        }
      ],
      "actions": [
        {
          "id": "view-in-lexware",
          "label": "View in Lexware",
          "link": "{lexware_url}",
          "target": "blank",
          "conditions": {
            "lexware_url": {
              "$exists": true,
              "$ne": null
            }
          }
        }
      ],
      "extra_actions": [
        {
          "id": "retry",
          "label": "Retry",
          "function": "process-document",
          "loading_label": "Trying again…",
          "hint": "Tries again to create this document in Lexware",
          "conditions": {
            "status": {
              "$in": [
                "failed",
                "skipped",
                "pending"
              ]
            }
          }
        },
        {
          "id": "refresh",
          "label": "Read again from Lexware",
          "function": "process-document",
          "loading_label": "Reading…",
          "hint": "After you finalized this draft in Lexware: fetches its PDF and status",
          "conditions": {
            "status": "created",
            "lexware_status": "draft"
          }
        },
        {
          "id": "resolve",
          "label": "Mark as resolved",
          "function": "resolve-document",
          "conditions": {
            "status": {
              "$in": [
                "failed",
                "skipped",
                "pending"
              ]
            }
          },
          "modal": {
            "title": "Mark as resolved",
            "description": "Use this after you created the document in Lexware by hand, or decided that none is needed. The app will not create it and stops listing it under Needs attention.",
            "submit_label": "Mark as resolved",
            "fields": [
              {
                "id": "number",
                "label": "Document number in Lexware (optional)",
                "type": "short_text"
              }
            ]
          }
        },
        {
          "id": "open-lexware",
          "label": "Open Lexware",
          "link": "https://app.lexware.de",
          "target": "blank"
        }
      ]
    }
  ]
}
